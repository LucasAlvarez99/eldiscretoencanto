# Copiá este archivo como .env (o cargá estas variables en tu hosting)

# Contraseña del panel /admin  (¡cambiala!)
ADMIN_PASSWORD=cambiame

# Opcional: firma de la sesión. Cualquier texto largo y al azar.
SESSION_SECRET=

# Puerto (el hosting suele definirlo solo)
PORT=3000

# --- Historias de Instagram automáticas (opcional) ---
# URL pública del sitio, con https. Instagram tiene que poder descargar la imagen desde acá.
PUBLIC_URL=https://tudominio.com
# ID de la cuenta de Instagram profesional (Business/Creator)
IG_USER_ID=
# Token de acceso de larga duración con permiso instagram_content_publish
IG_ACCESS_TOKEN=
